# Copiá este archivo como .env.local y ajustá los valores:
#   cp .env.example .env.local        (macOS / Linux)
#   copy .env.example .env.local      (Windows)
# .env.local NO se sube a GitHub (lo ignora .gitignore).

# URL pública del sitio. Se usa como "metadataBase" en src/app/layout.tsx
# para que los links absolutos de metadata (Open Graph, etc.) apunten al
# dominio correcto.
#   - En desarrollo: http://localhost:3000
#   - En producción (Vercel): la URL de tu deploy, ej. https://clickzone.vercel.app
# Es opcional: si no la definís, usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
